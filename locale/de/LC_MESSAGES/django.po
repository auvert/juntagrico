# auvert German translation overrides.
#
# Purpose: fix juntagrico 2.0.10, whose shipped German catalog resolves the
# signup "AGB" accept labels to a string containing a positional "{}"
# placeholder. juntagrico/forms/__init__.py:agb_label() formats these with
# NAMED arguments only (.format(organization=...) / format_html(..., documents=,
# organization=)), so a positional "{}" raises:
#   IndexError: Replacement index 0 out of range for positional args tuple
# on GET /signup/.
#
# LOCALE_PATHS entries take precedence over app catalogs, so these corrected
# translations (named placeholders) override the broken packaged ones.
msgid ""
msgstr ""
"Project-Id-Version: auvert\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: de\n"

#: juntagrico/forms/__init__.py:247
#, python-brace-format
msgid ""
"Ich habe {documents} gelesen und erkläre meinen Willen, \"{organization}\" "
"beizutreten. Hiermit beantrage ich meine Aufnahme."
msgstr ""
"Ich habe {documents} gelesen und erkläre meinen Willen, \"{organization}\" "
"beizutreten. Hiermit beantrage ich meine Aufnahme."

